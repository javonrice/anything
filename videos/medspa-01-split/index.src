<!doctype html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <script src="assets/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Inter"; font-weight: 500; src: url("assets/fonts/inter-latin-500-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 600; src: url("assets/fonts/inter-latin-600-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 700; src: url("assets/fonts/inter-latin-700-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 800; src: url("assets/fonts/inter-latin-800-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 900; src: url("assets/fonts/inter-latin-900-normal.woff2") format("woff2"); }

      :root {
        --bg: #0d0a12;
        --panel: #1a1522;
        --panel-2: #241d2f;
        --line: rgba(255, 255, 255, 0.1);
        --text: #f6f1f8;
        --muted: #a79fb2;
        --rose: #f2a7bd;
        --rose-deep: #e0718f;
        --green: #3ddc97;
        --red: #ff5468;
        --violet: #9b7bff;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: var(--bg); }
      body { font-family: "Inter", sans-serif; color: var(--text); }

      #root { position: relative; width: 100%; height: 100%; overflow: hidden;
        background: radial-gradient(1200px 900px at 50% 20%, #2a1630 0%, var(--bg) 60%); }

      /* ---------- layout ---------- */
      .scene { position: absolute; left: 0; top: 0; width: 1080px; height: 1200px; }
      #presenter { position: absolute; left: 0; top: 1200px; width: 1080px; height: 720px;
        background: linear-gradient(180deg, #17111d 0%, #0d0a12 100%);
        border-top: 2px solid rgba(242, 167, 189, 0.25); }
      .cam-tag { position: absolute; left: 40px; top: 32px; font-size: 22px; font-weight: 700; letter-spacing: 3px;
        color: rgba(246, 241, 248, 0.35); text-transform: uppercase; }
      .orb { position: absolute; left: 440px; top: 70px; width: 200px; height: 200px; border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #ffd3df 0%, var(--rose) 35%, var(--rose-deep) 70%, #7d2c4a 100%);
        box-shadow: 0 0 80px rgba(242, 167, 189, 0.45); }
      .orb-ring { position: absolute; left: 400px; top: 30px; width: 280px; height: 280px; border-radius: 50%;
        border: 3px solid rgba(242, 167, 189, 0.35); }
      .cap { position: absolute; left: 60px; top: 340px; width: 960px; height: 300px; display: flex;
        align-items: center; justify-content: center; text-align: center; opacity: 0;
        font-size: 70px; line-height: 1.15; font-weight: 900; letter-spacing: -1px; }
      .cap .w { color: rgba(246, 241, 248, 0.45); margin: 0 10px; }

      /* ---------- split frame ---------- */
      .half-bg { position: absolute; top: 0; width: 540px; height: 1200px; }
      .hdr { position: absolute; top: 36px; width: 540px; text-align: center; font-size: 38px; font-weight: 900; letter-spacing: 4px; }
      #divider { position: absolute; left: 538px; top: 30px; width: 4px; height: 1150px; border-radius: 2px;
        background: linear-gradient(180deg, rgba(255,255,255,0.0), rgba(255,255,255,0.25) 15%, rgba(255,255,255,0.25) 85%, rgba(255,255,255,0)); }
      .chip { position: absolute; left: 0; top: 116px; width: 1080px; display: flex; justify-content: center; }
      .chip span { display: block; padding: 12px 28px; border-radius: 999px; background: #2a1d33;
        border: 2px solid rgba(242, 167, 189, 0.5); color: var(--rose); font-size: 26px; font-weight: 800; letter-spacing: 3px; }
      .chip b { color: var(--text); }

      .score { position: absolute; top: 1066px; width: 480px; height: 104px; border-radius: 26px; }
      .score .lbl { position: absolute; left: 30px; top: 36px; font-size: 28px; font-weight: 800; letter-spacing: 3px; }
      .score .num { position: absolute; right: 34px; top: 14px; width: 120px; height: 76px; text-align: right; font-size: 64px; font-weight: 900; }
      .score .num span { position: absolute; right: 0; top: 0; }

      /* ---------- shared UI ---------- */
      .card { position: absolute; background: var(--panel); border: 2px solid var(--line); border-radius: 28px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45); }
      .bubble { position: absolute; padding: 18px 24px; border-radius: 26px; font-size: 28px; font-weight: 600; line-height: 1.3; }
      .b-in { background: var(--panel-2); color: var(--text); border-bottom-left-radius: 8px; }
      .b-out { background: #5b3fd6; color: #fff; border-bottom-right-radius: 8px; }
      .b-sms { background: #178a4c; color: #fff; border-bottom-right-radius: 8px; }
      .pill { position: absolute; padding: 12px 22px; border-radius: 999px; font-size: 28px; font-weight: 800; }
      .pill-red { background: rgba(255, 84, 104, 0.16); border: 2px solid var(--red); color: var(--red); }
      .pill-green { background: rgba(61, 220, 151, 0.16); border: 2px solid var(--green); color: var(--green); }
      .pill-grey { background: rgba(167, 159, 178, 0.12); border: 2px solid rgba(167, 159, 178, 0.6); color: var(--muted); }
      .avatar { border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #fff; }
      .note { position: absolute; font-size: 30px; font-weight: 800; line-height: 1.2; }

      /* call card */
      .call { position: absolute; top: 200px; width: 480px; height: 250px; }
      .call .avatar { position: absolute; left: 30px; top: 40px; width: 100px; height: 100px; font-size: 36px; }
      .call .nm { position: absolute; left: 150px; top: 48px; font-size: 34px; font-weight: 800; }
      .call .st { position: absolute; left: 150px; top: 96px; font-size: 26px; font-weight: 700; }
      .call .ring { position: absolute; left: 30px; top: 168px; width: 420px; height: 56px; border-radius: 28px; display: flex;
        align-items: center; justify-content: center; font-size: 26px; font-weight: 800; }

      /* list rows */
      .row { position: absolute; left: 20px; width: 440px; height: 120px; border-radius: 20px; background: var(--panel-2); }
      .row .avatar { position: absolute; left: 18px; top: 26px; width: 68px; height: 68px; font-size: 26px; }
      .row .n { position: absolute; left: 104px; top: 22px; font-size: 30px; font-weight: 800; }
      .row .d { position: absolute; left: 104px; top: 66px; font-size: 26px; font-weight: 600; color: var(--muted); }
      .row .st { position: absolute; right: 16px; top: 36px; padding: 8px 16px; border-radius: 999px; font-size: 26px; font-weight: 800; }
      .st-sent { background: rgba(155, 123, 255, 0.2); color: #c4b2ff; }
      .st-booked { background: rgba(61, 220, 151, 0.2); color: var(--green); }
      .st-none { background: rgba(167, 159, 178, 0.15); color: var(--muted); }

      /* payoff */
      .res-row { position: absolute; left: 90px; width: 900px; height: 170px; border-radius: 30px; background: var(--panel);
        border: 2px solid var(--line); }
      .res-row .ic { position: absolute; left: 30px; top: 35px; width: 100px; height: 100px; border-radius: 26px;
        display: flex; align-items: center; justify-content: center; }
      .res-row .a { position: absolute; left: 160px; top: 36px; font-size: 30px; font-weight: 700; color: var(--muted); text-decoration: line-through; text-decoration-color: var(--red); }
      .res-row .b { position: absolute; left: 160px; top: 82px; font-size: 44px; font-weight: 900; }
      .res-row .ok { position: absolute; right: 34px; top: 50px; width: 70px; height: 70px; border-radius: 50%; background: var(--green);
        display: flex; align-items: center; justify-content: center; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="61.2" data-width="1080" data-height="1920">

      <audio id="vo" src="assets/voiceover.mp3" data-start="0" data-duration="60.92" data-track-index="9" data-volume="1"></audio>

      <!-- ================= split frame: headers, divider, scoreboard (0 - 49.5) ================= -->
      <div id="frame" class="scene clip" data-start="0" data-duration="49.5" data-track-index="2">
        <div id="lbg" class="half-bg" style="left: 0; background: linear-gradient(180deg, rgba(255,84,104,0.07), rgba(13,10,18,0) 40%);"></div>
        <div id="rbg" class="half-bg" style="left: 540px; background: linear-gradient(180deg, rgba(61,220,151,0.09), rgba(13,10,18,0) 40%);"></div>
        <div id="hdr-l" class="hdr" style="left: 0; color: #d9707f;">WITHOUT</div>
        <div id="hdr-r" class="hdr" style="left: 540px; color: var(--green);">WITH THE SYSTEM</div>
        <div id="divider"></div>
        <div id="score-l" class="score" style="left: 30px; background: rgba(255,84,104,0.1); border: 2px solid rgba(255,84,104,0.5);">
          <div class="lbl" style="color: #d9707f;">BOOKED</div>
          <div class="num" style="color: var(--red);"><span>0</span></div>
        </div>
        <div id="score-r" class="score" style="left: 570px; background: rgba(61,220,151,0.1); border: 2px solid rgba(61,220,151,0.5);">
          <div class="lbl" style="color: var(--green);">BOOKED</div>
          <div class="num" style="color: var(--green);">
            <span id="sr0">0</span><span id="sr1">1</span><span id="sr2">2</span><span id="sr3">3</span>
            <span id="sr4">4</span><span id="sr5">5</span><span id="sr6">6</span><span id="sr7">7</span>
          </div>
        </div>
      </div>

      <!-- ================= P1: same call, two outcomes (0 - 11.45) ================= -->
      <div id="p1" class="scene clip" data-start="0" data-duration="11.45" data-track-index="1">
        <div class="chip" id="p1-chip"><span>SAME CALL · <b>TWO OUTCOMES</b></span></div>
        <!-- left -->
        <div id="p1-cl" class="card call" style="left: 30px;">
          <div class="avatar" style="background: linear-gradient(135deg,#c2577a,#6d4dff);">SK</div>
          <div class="nm">Sarah K.</div>
          <div class="st" style="color: var(--muted);">Incoming call</div>
          <div id="p1-ringl" class="ring" style="background: #178a4c;">Ringing...</div>
        </div>
        <div id="p1-busy" class="pill" style="left: 30px; top: 480px; background: rgba(242,167,189,0.14); border: 2px solid var(--rose); color: var(--rose);">You: with a patient</div>
        <div id="p1-miss" class="pill pill-red" style="left: 30px; top: 560px; width: 300px;" data-layout-allow-overlap>
          Missed calls: <span id="p1-m1" style="position:absolute; left: 236px;">1</span><span id="p1-m2" style="position:absolute; left: 236px;">2</span><span id="p1-m3" style="position:absolute; left: 236px;">3</span>
        </div>
        <div id="p1-vm" class="note" style="left: 30px; top: 650px; width: 480px; color: var(--red);">No voicemail. Just gone.</div>
        <div id="p1-g" class="card" style="left: 30px; top: 730px; width: 480px; height: 150px;">
          <div style="position:absolute; left: 24px; top: 26px; width: 96px; height: 96px; border-radius: 22px; background: linear-gradient(135deg,#ffc94d,#ff8a4d);"></div>
          <div style="position:absolute; left: 140px; top: 30px; font-size: 32px; font-weight: 800;">Glow Aesthetics</div>
          <div style="position:absolute; left: 140px; top: 80px; font-size: 26px; font-weight: 600; color: var(--muted);">Competitor · Call now</div>
          <div id="p1-tap" style="position:absolute; left: 380px; top: 34px; width: 80px; height: 80px; border-radius: 50%; background: rgba(255,255,255,0.35); border: 4px solid #fff;"></div>
        </div>
        <div id="p1-lost" class="pill pill-red" style="left: 30px; top: 910px; font-size: 32px;">Booked somewhere else</div>
        <!-- right -->
        <div id="p1-cr" class="card call" style="left: 570px;">
          <div class="avatar" style="background: linear-gradient(135deg,#c2577a,#6d4dff);">SK</div>
          <div class="nm">Sarah K.</div>
          <div class="st" style="color: var(--muted);">Incoming call</div>
          <div id="p1-ringr" class="ring" style="background: #178a4c;">Ringing...</div>
        </div>
        <div id="p1-dim" style="position:absolute; left: 542px; top: 180px; width: 538px; height: 870px;">
          <div id="p1-q" style="position:absolute; left: 0; top: 280px; width: 538px; text-align: center; font-size: 200px; font-weight: 900; color: var(--green);">?</div>
          <div id="p1-qt" style="position:absolute; left: 0; top: 540px; width: 538px; text-align: center; font-size: 34px; font-weight: 800; color: var(--text);">Now watch this side</div>
        </div>
      </div>

      <!-- ================= P2: AI receptionist (11.45 - 28.2) ================= -->
      <div id="p2" class="scene clip" data-start="11.45" data-duration="16.75" data-track-index="1">
        <div class="chip" id="p2-chip"><span>SYSTEM 1 · <b>AI RECEPTIONIST</b></span></div>
        <!-- left -->
        <div id="p2-cl" class="card call" style="left: 30px;">
          <div class="avatar" style="background: #4a4352;">SK</div>
          <div class="nm">Sarah K.</div>
          <div class="st" style="color: var(--red);">Missed call</div>
          <div class="ring" style="background: rgba(255,84,104,0.15); color: var(--red);">Nobody picked up</div>
        </div>
        <div id="p2-lq" class="bubble b-in" style="left: 30px; top: 490px; width: 400px;" data-layout-allow-overlap>"How much is Botox?"</div>
        <div id="p2-la" class="note" style="left: 30px; top: 610px; width: 480px; color: var(--muted);" data-layout-allow-overlap>No answer...</div>
        <div id="p2-lcal" class="card" style="left: 30px; top: 770px; width: 480px; height: 200px;" data-layout-allow-overlap>
          <div style="position:absolute; left: 24px; top: 20px; font-size: 26px; font-weight: 800; color: var(--muted); letter-spacing: 2px;">FRIDAY</div>
          <div style="position:absolute; left: 24px; top: 70px; width: 430px; height: 52px; border-radius: 14px; background: var(--panel-2); font-size: 26px; font-weight: 700; color: var(--muted); padding: 10px 18px;">1:00 PM · Lip filler</div>
          <div style="position:absolute; left: 24px; top: 132px; width: 430px; height: 52px; border-radius: 14px; border: 3px dashed rgba(255,84,104,0.5); font-size: 26px; font-weight: 700; color: #d9707f; padding: 8px 18px;">2:00 PM · still empty</div>
        </div>
        <div id="p2-lhang" class="note" style="left: 30px; top: 490px; width: 480px;" data-layout-allow-overlap>Caller hung up.</div>
        <div id="p2-lnone" class="note" style="left: 30px; top: 570px; width: 480px; color: var(--muted);" data-layout-allow-overlap>No follow-up. No text.</div>
        <div id="p2-llost" class="pill pill-red" style="left: 30px; top: 880px; font-size: 34px;" data-layout-allow-overlap>Client lost</div>
        <!-- right -->
        <div id="p2-cr" class="card call" style="left: 570px; border-color: rgba(61,220,151,0.4);">
          <div class="avatar" style="background: linear-gradient(135deg,#9b7bff,#f2a7bd);">
            <svg width="54" height="54" viewBox="0 0 24 24" fill="#fff"><path d="M12 2l1.8 5.4L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.6z"/><path d="M19 14l.9 2.6L22 17.5l-2.1.9L19 21l-.9-2.6L16 17.5l2.1-.9z"/></svg>
          </div>
          <div class="nm">AI Receptionist</div>
          <div class="st" style="color: var(--green);">Answered · 0:14</div>
          <div id="p2-bars" class="ring" style="background: rgba(61,220,151,0.1); justify-content: space-evenly;">
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
            <div class="bar" style="width:14px; height:40px; border-radius:7px; background: var(--green);"></div>
          </div>
        </div>
        <div id="p2-rq" class="bubble b-in" style="left: 570px; top: 490px; width: 400px;" data-layout-allow-overlap>"How much is Botox?"</div>
        <div id="p2-ra" class="bubble b-out" style="left: 610px; top: 600px; width: 440px;" data-layout-allow-overlap>"$12 a unit. Friday at 2pm work?"</div>
        <div id="p2-rcal" class="card" style="left: 570px; top: 770px; width: 480px; height: 200px;" data-layout-allow-overlap>
          <div style="position:absolute; left: 24px; top: 20px; font-size: 26px; font-weight: 800; color: var(--muted); letter-spacing: 2px;">FRIDAY</div>
          <div style="position:absolute; left: 24px; top: 70px; width: 430px; height: 52px; border-radius: 14px; background: var(--panel-2); font-size: 26px; font-weight: 700; color: var(--muted); padding: 10px 18px;">1:00 PM · Lip filler</div>
          <div id="p2-slot" style="position:absolute; left: 24px; top: 132px; width: 430px; height: 52px; border-radius: 14px; border: 3px dashed rgba(255,255,255,0.25); font-size: 26px; font-weight: 700; color: var(--muted); padding: 8px 18px;" data-layout-allow-overlap>2:00 PM · open</div>
          <div id="p2-fill" style="position:absolute; left: 24px; top: 132px; width: 430px; height: 52px; border-radius: 14px; background: linear-gradient(90deg, #5b3fd6, #b4466a); font-size: 26px; font-weight: 800; color: #fff; padding: 10px 18px; opacity: 0;" data-layout-allow-overlap>2:00 PM · Botox · Sarah</div>
        </div>
        <div id="p2-rbook" class="pill pill-green" style="left: 880px; top: 720px;" data-layout-allow-overlap>Booked</div>
        <div id="p2-rhang" class="note" style="left: 570px; top: 490px; width: 480px;" data-layout-allow-overlap>Caller hung up?</div>
        <div id="p2-rsms" class="bubble b-sms" style="left: 590px; top: 560px; width: 440px; font-size: 27px;" data-layout-allow-overlap>Hi Sarah! Sorry we missed you. Book here: glowspa.com/book</div>
        <div id="p2-rsec" class="pill pill-green" style="left: 570px; top: 790px;" data-layout-allow-overlap>Text sent in 3 sec</div>
        <div id="p2-rsave" class="pill pill-green" style="left: 570px; top: 880px; font-size: 34px;" data-layout-allow-overlap>Client saved</div>
      </div>

      <!-- ================= P3: Instagram DM at 11pm (28.2 - 39.35) ================= -->
      <div id="p3" class="scene clip" data-start="28.2" data-duration="11.15" data-track-index="1">
        <div class="chip" id="p3-chip"><span>SYSTEM 2 · <b>INSTANT DM REPLIES</b></span></div>
        <!-- left -->
        <div id="p3-dl" class="card" style="left: 30px; top: 200px; width: 480px; height: 520px; background: #000;">
          <div class="avatar" style="position:absolute; left: 24px; top: 22px; width: 64px; height: 64px; font-size: 24px; background: linear-gradient(135deg,#b07a20,#a01f5a,#3c46a8);">JM</div>
          <div style="position:absolute; left: 104px; top: 22px; font-size: 28px; font-weight: 800;">jess.m</div>
          <div style="position:absolute; left: 104px; top: 58px; font-size: 26px; font-weight: 600; color: var(--muted);">Instagram</div>
          <div style="position:absolute; left: 0; top: 116px; width: 476px; text-align: center; font-size: 26px; font-weight: 700; color: var(--muted);">11:04 PM</div>
          <div id="p3-lmsg" class="bubble" style="left: 24px; top: 170px; width: 330px; background: #262626;">How much for lips?</div>
          <div id="p3-seen" style="position:absolute; left: 24px; top: 270px; font-size: 26px; font-weight: 700; color: var(--muted);">Seen · no reply</div>
          <div id="p3-zz" class="bubble" style="left: 24px; top: 350px; width: 420px; background: rgba(167,159,178,0.12); border: 2px dashed rgba(167,159,178,0.5); color: var(--muted);">You reply tomorrow at 9am</div>
        </div>
        <div id="p3-lgone" class="pill pill-red" style="left: 30px; top: 760px; font-size: 32px;">She booked elsewhere</div>
        <!-- right -->
        <div id="p3-dr" class="card" style="left: 570px; top: 200px; width: 480px; height: 520px; background: #000; border-color: rgba(61,220,151,0.4);">
          <div class="avatar" style="position:absolute; left: 24px; top: 22px; width: 64px; height: 64px; font-size: 24px; background: linear-gradient(135deg,#b07a20,#a01f5a,#3c46a8);">JM</div>
          <div style="position:absolute; left: 104px; top: 22px; font-size: 28px; font-weight: 800;">jess.m</div>
          <div style="position:absolute; left: 104px; top: 58px; font-size: 26px; font-weight: 600; color: var(--muted);">Instagram</div>
          <div style="position:absolute; left: 0; top: 116px; width: 476px; text-align: center; font-size: 26px; font-weight: 700; color: var(--muted);">11:04 PM</div>
          <div id="p3-rmsg" class="bubble" style="left: 24px; top: 170px; width: 330px; background: #262626;">How much for lips?</div>
          <div id="p3-dots" class="bubble" style="left: 330px; top: 270px; width: 120px; height: 60px; background: #1f66c9; padding: 0;" data-layout-allow-overlap>
            <div style="position:absolute; left: 22px; top: 22px; width: 16px; height: 16px; border-radius:50%; background:#fff;"></div>
            <div style="position:absolute; left: 52px; top: 22px; width: 16px; height: 16px; border-radius:50%; background:#fff;"></div>
            <div style="position:absolute; left: 82px; top: 22px; width: 16px; height: 16px; border-radius:50%; background:#fff;"></div>
          </div>
          <div id="p3-rep" class="bubble" style="left: 90px; top: 270px; width: 360px; background: #1f66c9; font-size: 27px;" data-layout-allow-overlap>Lip filler starts at $650! Grab a time:</div>
          <div id="p3-btn" style="position:absolute; left: 90px; top: 420px; width: 360px; height: 72px; border-radius: 18px; background: #fff; color: #000; font-size: 28px; font-weight: 900; display:flex; align-items:center; justify-content:center;">Book now</div>
          <div id="p3-tap" style="position:absolute; left: 230px; top: 416px; width: 80px; height: 80px; border-radius: 50%; background: rgba(55,151,240,0.35); border: 4px solid #3797f0;"></div>
        </div>
        <div id="p3-rinst" class="pill pill-green" style="left: 570px; top: 760px;">Replied instantly</div>
        <div id="p3-rbook" class="pill pill-green" style="left: 570px; top: 850px; font-size: 34px;">Booked</div>
      </div>

      <!-- ================= P4: win back old clients (39.35 - 49.5) ================= -->
      <div id="p4" class="scene clip" data-start="39.35" data-duration="10.15" data-track-index="1">
        <div class="chip" id="p4-chip"><span>SYSTEM 3 · <b>WIN BACK OLD CLIENTS</b></span></div>
        <div id="p4-ll" class="card" style="left: 30px; top: 200px; width: 480px; height: 840px;">
          <div style="position:absolute; left: 24px; top: 24px; font-size: 26px; font-weight: 800; color: var(--muted); letter-spacing: 2px;">NO VISIT IN 6+ MONTHS</div>
          <div id="l1" class="row" style="top: 80px;" data-layout-allow-overlap><div class="avatar" style="background:#9c4560;">AL</div><div class="n">Ashley L.</div><div class="d">7 mo ago</div><div class="st st-none">Gone</div></div>
          <div id="l2" class="row" style="top: 230px;" data-layout-allow-overlap><div class="avatar" style="background:#6c5b7b;">MR</div><div class="n">Maria R.</div><div class="d">9 mo ago</div><div class="st st-none">Gone</div></div>
          <div id="l3" class="row" style="top: 380px;" data-layout-allow-overlap><div class="avatar" style="background:#355c7d;">TJ</div><div class="n">Tasha J.</div><div class="d">6 mo ago</div><div class="st st-none">Gone</div></div>
          <div id="l4" class="row" style="top: 530px;" data-layout-allow-overlap><div class="avatar" style="background:#c23f52;">KB</div><div class="n">Kim B.</div><div class="d">1 yr ago</div><div class="st st-none">Gone</div></div>
          <div id="l5" class="row" style="top: 680px;" data-layout-allow-overlap><div class="avatar" style="background:#4f7a4e;">DP</div><div class="n">Dana P.</div><div class="d">8 mo ago</div><div class="st st-none">Gone</div></div>
        </div>
        <div id="p4-never" class="pill pill-red" style="left: 110px; top: 488px; font-size: 34px; background: #2a1219;" data-layout-allow-overlap>Never came back</div>
        <div id="p4-rl" class="card" style="left: 570px; top: 200px; width: 480px; height: 840px; border-color: rgba(61,220,151,0.4);">
          <div style="position:absolute; left: 24px; top: 24px; font-size: 26px; font-weight: 800; color: var(--muted); letter-spacing: 2px;">NO VISIT IN 6+ MONTHS</div>
          <div id="r1" class="row" style="top: 80px;" data-layout-allow-overlap><div class="avatar" style="background:#9c4560;">AL</div><div class="n">Ashley L.</div><div class="d">7 mo ago</div><div class="st st-sent">Texted</div><div class="st st-booked">Booked</div></div>
          <div id="r2" class="row" style="top: 230px;" data-layout-allow-overlap><div class="avatar" style="background:#6c5b7b;">MR</div><div class="n">Maria R.</div><div class="d">9 mo ago</div><div class="st st-sent">Texted</div><div class="st st-booked">Booked</div></div>
          <div id="r3" class="row" style="top: 380px;" data-layout-allow-overlap><div class="avatar" style="background:#355c7d;">TJ</div><div class="n">Tasha J.</div><div class="d">6 mo ago</div><div class="st st-sent">Texted</div><div class="st st-booked">Booked</div></div>
          <div id="r4" class="row" style="top: 530px;" data-layout-allow-overlap><div class="avatar" style="background:#c23f52;">KB</div><div class="n">Kim B.</div><div class="d">1 yr ago</div><div class="st st-sent">Texted</div><div class="st st-booked">Booked</div></div>
          <div id="r5" class="row" style="top: 680px;" data-layout-allow-overlap><div class="avatar" style="background:#4f7a4e;">DP</div><div class="n">Dana P.</div><div class="d">8 mo ago</div><div class="st st-sent">Texted</div><div class="st st-booked">Booked</div></div>
        </div>
      </div>

      <!-- ================= P5: payoff, right side takes over (49.5 - 55.6) ================= -->
      <div id="p5" class="scene clip" data-start="49.5" data-duration="6.1" data-track-index="1">
        <div id="p5-bg" style="position:absolute; left: 540px; top: 0; width: 540px; height: 1200px; background: linear-gradient(180deg, rgba(61,220,151,0.14), rgba(13,10,18,0) 55%);"></div>
        <div id="p5-title" style="position:absolute; left:0; top: 50px; width:1080px; text-align:center; font-size: 40px; font-weight: 900; letter-spacing: 6px; color: var(--green);">WITH THE SYSTEM</div>
        <div id="x1" class="res-row" style="top: 170px;">
          <div class="ic" style="background: rgba(61,220,151,0.15);"><svg width="54" height="54" viewBox="0 0 24 24" fill="#3ddc97"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg></div>
          <div class="a">Missed calls</div><div class="b">Every call answered</div>
          <div class="ok"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0d0a12" stroke-width="3.5"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
        </div>
        <div id="x2" class="res-row" style="top: 370px;">
          <div class="ic" style="background: rgba(55,151,240,0.15);"><svg width="54" height="54" viewBox="0 0 24 24" fill="#3797f0"><path d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4V6a2 2 0 0 1 2-2z"/></svg></div>
          <div class="a">Ignored DMs</div><div class="b">Answered instantly</div>
          <div class="ok"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0d0a12" stroke-width="3.5"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
        </div>
        <div id="x3" class="res-row" style="top: 570px;">
          <div class="ic" style="background: rgba(242,167,189,0.15);"><svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="#f2a7bd" stroke-width="2.6"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg></div>
          <div class="a">Old clients</div><div class="b">Back in your chair</div>
          <div class="ok"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#0d0a12" stroke-width="3.5"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
        </div>
        <div id="p5-vs" style="position:absolute; left: 90px; top: 810px; width: 900px; height: 200px; border-radius: 30px; background: rgba(61,220,151,0.12); border: 3px solid var(--green);">
          <div style="position:absolute; left: 0; top: 30px; width: 896px; text-align: center; font-size: 30px; font-weight: 800; letter-spacing: 3px; color: var(--muted);">BOOKED IN THIS VIDEO</div>
          <div style="position:absolute; left: 0; top: 80px; width: 896px; text-align: center; font-size: 76px; font-weight: 900; color: var(--green);">7 <span style="color: var(--muted); font-size: 44px;">vs</span> <span style="color: var(--red);">0</span></div>
        </div>
      </div>

      <!-- ================= P6: CTA (55.6 - 61.2) ================= -->
      <div id="p6" class="scene clip" data-start="55.6" data-duration="5.6" data-track-index="1">
        <div id="s7-q" style="position:absolute; left:0; top: 170px; width:1080px; text-align:center; font-size: 80px; font-weight: 900; letter-spacing: -2px;">Own a med spa?</div>
        <div id="s7-box" style="position:absolute; left: 140px; top: 400px; width: 800px; height: 150px; border-radius: 75px; background: #fff; display:flex; align-items:center; padding-left: 60px;">
          <div style="font-size: 40px; font-weight: 600; color: #6b6b6b;">Comment</div>
          <div id="s7-spa" style="margin-left: 24px; font-size: 64px; font-weight: 900; color: #c2577a; letter-spacing: 4px;">"SPA"</div>
        </div>
        <div id="s7-sub" style="position:absolute; left: 0; top: 620px; width:1080px; text-align:center; font-size: 46px; font-weight: 800; color: var(--rose); line-height: 1.25;"><span style="display:block; width: 760px; margin: 0 auto;">I'll show you how this would work for yours</span></div>
        <div id="s7-arrow" style="position:absolute; left: 490px; top: 880px; width: 100px; height: 160px;">
          <svg width="100" height="160" viewBox="0 0 100 160" fill="none" stroke="#f2a7bd" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"><path d="M50 10v130"/><path d="M14 104l36 36 36-36"/></svg>
        </div>
      </div>

      <!-- ================= presenter zone (camera goes here later) ================= -->
      <div id="presenter" class="clip" data-start="0" data-duration="61.2" data-track-index="0">
        <div class="cam-tag">Your camera here</div>
        <div id="orb-ring" class="orb-ring"></div>
        <div id="orb" class="orb"></div>
        <div id="caps"></div>
      </div>
    </div>

    <script>
      const WORDS = __WORDS__;
      const tl = gsap.timeline({ paused: true });
      const E = "power3.out";
      const pop = (sel, t) => tl.fromTo(sel, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(2.2)" }, t);
      const rise = (sel, t, dy = 24) => tl.fromTo(sel, { opacity: 0, y: dy }, { opacity: 1, y: 0, duration: 0.4, ease: E }, t);
      const out = (sel, t) => tl.to(sel, { opacity: 0, duration: 0.3, ease: "power2.in" }, t);

      // ---------- captions (bottom zone) ----------
      const caps = document.getElementById("caps");
      const groups = [];
      let cur = [];
      WORDS.forEach((w, i) => {
        cur.push(w);
        const endsSentence = /[.,?!"]$/.test(w[0]);
        const next = WORDS[i + 1];
        const gap = next ? next[1] - w[2] : 1;
        if (cur.length >= 4 || endsSentence || gap > 0.3 || !next) { groups.push(cur); cur = []; }
      });
      groups.forEach((g, gi) => {
        const el = document.createElement("div");
        el.className = "cap";
        el.id = "cap" + gi;
        el.innerHTML = g.map((w, wi) => `<span class="w" id="cap${gi}w${wi}">${w[0].replace(/"/g, "")}</span>`).join(" ");
        caps.appendChild(el);
        const start = g[0][1];
        const nextG = groups[gi + 1];
        const end = nextG ? nextG[0][1] : g[g.length - 1][2] + 0.3;
        tl.fromTo(el, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.15, ease: E }, start);
        tl.set(el, { opacity: 0 }, end);
        g.forEach((w, wi) => {
          tl.set(`#cap${gi}w${wi}`, { color: /SPA|AI|Google|Instagram|instantly|calendar|lips|seconds|money|book/i.test(w[0]) ? "#f2a7bd" : "#ffffff" }, w[1]);
        });
      });

      // orb "speaking" pulse, keyed to word starts
      WORDS.forEach((w) => {
        tl.fromTo("#orb", { scale: 1.08 }, { scale: 1, duration: Math.max(0.12, w[2] - w[1]), ease: "power2.out" }, w[1]);
      });
      tl.fromTo("#orb-ring", { scale: 0.9, opacity: 0.6 }, { scale: 1.15, opacity: 0, duration: 1.6, ease: "sine.out", repeat: 37 }, 0);

      // ---------- frame + scoreboard (0 - 49.5) ----------
      rise("#hdr-l", 0.1, -20);
      tl.fromTo("#hdr-r", { opacity: 0, y: -20 }, { opacity: 0.35, y: 0, duration: 0.4, ease: E }, 0.1);
      tl.fromTo("#divider", { scaleY: 0 }, { scaleY: 1, duration: 0.6, ease: E, transformOrigin: "top center" }, 0.1);
      rise("#score-l", 0.5);
      rise("#score-r", 0.5);
      tl.to("#hdr-r", { opacity: 1, duration: 0.3 }, 11.45);
      for (let i = 1; i <= 7; i++) tl.set(`#sr${i}`, { opacity: 0 }, 0);
      [21.8, 27.2, 35.9, 47.5, 47.9, 48.3, 48.7].forEach((t, i) => {
        tl.set(`#sr${i}`, { opacity: 0 }, t);
        tl.fromTo(`#sr${i + 1}`, { opacity: 0, scale: 1.8 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, t);
        tl.to("#score-r", { scale: 1.06, duration: 0.12, ease: "power2.out" }, t);
        tl.to("#score-r", { scale: 1, duration: 0.25, ease: "power2.in" }, t + 0.12);
      });
      tl.to(["#lbg", "#hdr-l", "#score-l"], { opacity: 0, duration: 0.3 }, 49.2);
      tl.to(["#divider", "#rbg", "#hdr-r", "#score-r"], { opacity: 0, duration: 0.3 }, 49.2);

      // ---------- P1: same call (0 - 11.45) ----------
      rise("#p1-chip", 0.4, -20);
      rise("#p1-cl", 0.3, 50);
      rise("#p1-cr", 0.3, 50);
      ["#p1-cl", "#p1-cr"].forEach((s) => tl.fromTo(s, { rotation: -1.5 }, { rotation: 1.5, duration: 0.07, repeat: 23, yoyo: true, ease: "none" }, 2.3));
      ["#p1-ringl", "#p1-ringr"].forEach((s) => tl.fromTo(s, { scale: 1 }, { scale: 1.04, duration: 0.3, repeat: 9, yoyo: true, ease: "sine.inOut" }, 2.3));
      tl.fromTo("#p1-dim", { opacity: 0 }, { opacity: 1, duration: 0.5 }, 1.0);
      tl.to("#p1-cr", { opacity: 0.35, duration: 0.5 }, 1.0);
      tl.fromTo("#p1-q", { scale: 0.85 }, { scale: 1.05, duration: 0.8, repeat: 11, yoyo: true, ease: "sine.inOut" }, 1.2);
      rise("#p1-qt", 1.6);
      rise("#p1-busy", 3.3);
      tl.fromTo("#p1-miss", { opacity: 0, x: -30, scale: 1 }, { opacity: 1, x: 0, scale: 1, duration: 0.35, ease: "back.out(2)" }, 3.9);
      tl.set(["#p1-m2", "#p1-m3"], { opacity: 0 }, 0);
      tl.set("#p1-m1", { opacity: 0 }, 4.45); tl.set("#p1-m2", { opacity: 1 }, 4.45);
      tl.set("#p1-m2", { opacity: 0 }, 5.0); tl.set("#p1-m3", { opacity: 1 }, 5.0);
      [4.45, 5.0].forEach((t) => { tl.to("#p1-miss", { scale: 1.08, duration: 0.1 }, t); tl.to("#p1-miss", { scale: 1, duration: 0.2 }, t + 0.1); });
      tl.to("#p1-cl", { opacity: 0.45, duration: 0.4 }, 6.0);
      tl.to("#p1-ringl", { backgroundColor: "#5a2430", duration: 0.3 }, 6.0);
      rise("#p1-vm", 7.8);
      rise("#p1-g", 9.0);
      tl.fromTo("#p1-tap", { opacity: 0, scale: 1.6 }, { opacity: 1, scale: 1, duration: 0.25, ease: E }, 9.7);
      tl.to("#p1-tap", { opacity: 0, scale: 2.2, duration: 0.5 }, 9.95);
      pop("#p1-lost", 10.4);

      // ---------- P2: AI receptionist (11.45 - 28.2) ----------
      rise("#p2-chip", 11.55, -20);
      rise("#p2-cl", 11.6, 30);
      tl.fromTo("#p2-cr", { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.6)" }, 14.9);
      document.querySelectorAll("#p2-bars .bar").forEach((b, i) => {
        tl.fromTo(b, { scaleY: 0.25 }, { scaleY: 0.5 + ((i * 37) % 50) / 100, duration: 0.18 + (i % 3) * 0.05, repeat: 30, yoyo: true, ease: "sine.inOut" }, 15.0 + i * 0.03);
      });
      rise("#p2-lq", 17.1); rise("#p2-rq", 17.1);
      rise("#p2-la", 18.7); tl.fromTo("#p2-ra", { opacity: 0, x: 30 }, { opacity: 1, x: 0, duration: 0.4, ease: E }, 18.7);
      rise("#p2-lcal", 20.4); rise("#p2-rcal", 20.4);
      tl.fromTo("#p2-fill", { opacity: 0, scaleX: 0.2 }, { opacity: 1, scaleX: 1, duration: 0.45, ease: E, transformOrigin: "left center" }, 21.5);
      pop("#p2-rbook", 21.8);
      out(["#p2-lq", "#p2-la", "#p2-lcal", "#p2-rq", "#p2-ra", "#p2-rcal", "#p2-rbook"], 22.5);
      tl.to("#p2-cr .st", { color: "#a79fb2", duration: 0.2 }, 23.2);
      rise("#p2-lhang", 23.2); rise("#p2-rhang", 23.2);
      rise("#p2-lnone", 25.0);
      tl.fromTo("#p2-rsms", { opacity: 0, y: 30, scale: 0.92 }, { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: "back.out(1.6)" }, 25.0);
      pop("#p2-rsec", 25.5);
      pop("#p2-llost", 27.2);
      pop("#p2-rsave", 27.2);

      // ---------- P3: Instagram DM (28.2 - 39.35) ----------
      rise("#p3-chip", 28.3, -20);
      rise("#p3-dl", 28.5, 50); rise("#p3-dr", 28.5, 50);
      rise("#p3-lmsg", 30.9, 16); rise("#p3-rmsg", 30.9, 16);
      tl.fromTo("#p3-dots", { opacity: 0 }, { opacity: 1, duration: 0.15 }, 33.2);
      tl.to("#p3-dots", { opacity: 0, duration: 0.1 }, 33.65);
      rise("#p3-rep", 33.65, 16);
      rise("#p3-seen", 33.7, 10);
      pop("#p3-rinst", 34.1);
      pop("#p3-btn", 34.8);
      tl.fromTo("#p3-tap", { opacity: 0, scale: 1.6 }, { opacity: 1, scale: 1, duration: 0.25, ease: E }, 35.5);
      tl.to("#p3-tap", { opacity: 0, scale: 2.2, duration: 0.5 }, 35.75);
      pop("#p3-rbook", 35.9);
      rise("#p3-zz", 36.8, 16);
      tl.to("#p3-dl", { opacity: 0.55, duration: 0.4 }, 38.0);
      pop("#p3-lgone", 38.2);

      // ---------- P4: win back (39.35 - 49.5) ----------
      rise("#p4-chip", 39.45, -20);
      rise("#p4-ll", 39.9, 50); rise("#p4-rl", 39.9, 50);
      [1, 2, 3, 4, 5].forEach((n, i) => {
        tl.fromTo(`#l${n}`, { opacity: 0, x: -20 }, { opacity: 0.6, x: 0, duration: 0.3, ease: E }, 40.4 + i * 0.12);
        tl.fromTo(`#r${n}`, { opacity: 0, x: -20 }, { opacity: 0.6, x: 0, duration: 0.3, ease: E }, 40.4 + i * 0.12);
        tl.set(`#l${n} .st-none`, { opacity: 0 }, 0);
        tl.set(`#r${n} .st-sent`, { opacity: 0 }, 0);
        tl.set(`#r${n} .st-booked`, { opacity: 0 }, 0);
        const t = 44.3 + i * 0.2;
        tl.fromTo(`#r${n} .st-sent`, { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, t);
        tl.to(`#r${n}`, { opacity: 0.85, duration: 0.2 }, t);
      });
      [1, 2, 3, 4, 5].forEach((n, i) => {
        const t = 46.4 + i * 0.15;
        tl.fromTo(`#l${n} .st-none`, { opacity: 0 }, { opacity: 1, duration: 0.25 }, t);
        tl.to(`#l${n}`, { opacity: 0.3, duration: 0.4 }, t);
      });
      pop("#p4-never", 47.2);
      [1, 2, 4, 5].forEach((n, i) => {
        const t = [47.5, 47.9, 48.3, 48.7][i];
        tl.to(`#r${n} .st-sent`, { opacity: 0, duration: 0.15 }, t);
        tl.fromTo(`#r${n} .st-booked`, { opacity: 0, scale: 0.5 }, { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(2.5)" }, t);
        tl.to(`#r${n}`, { opacity: 1, backgroundColor: "rgba(61,220,151,0.14)", duration: 0.3 }, t);
      });

      // ---------- P5: payoff (49.5 - 55.6) ----------
      tl.fromTo("#p5-bg", { x: 0, width: 540 }, { x: -540, width: 1080, duration: 0.6, ease: "power3.inOut" }, 49.5);
      tl.fromTo("#p5-title", { opacity: 0, x: 270 }, { opacity: 1, x: 0, duration: 0.6, ease: "power3.inOut" }, 49.5);
      [["#x1", 49.7], ["#x2", 51.0], ["#x3", 52.8]].forEach(([s, t]) => {
        tl.fromTo(s, { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.45, ease: E }, t);
        tl.fromTo(`${s} .ok`, { scale: 0 }, { scale: 1, duration: 0.4, ease: "back.out(3)" }, t + 0.35);
      });
      tl.fromTo("#p5-vs", { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(2)" }, 53.2);

      // ---------- P6: CTA (55.6 - 61.2) ----------
      tl.fromTo("#s7-q", { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.5, ease: E }, 55.75);
      tl.fromTo("#s7-box", { opacity: 0, scale: 0.85 }, { opacity: 1, scale: 1, duration: 0.45, ease: "back.out(1.8)" }, 56.9);
      tl.fromTo("#s7-spa", { opacity: 0, scale: 1.8 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, 57.65);
      tl.fromTo("#s7-sub", { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.45, ease: E }, 58.6);
      tl.fromTo("#s7-arrow", { opacity: 0, y: -20 }, { opacity: 1, y: 20, duration: 0.5, repeat: 7, yoyo: true, ease: "sine.inOut" }, 57.9);

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
