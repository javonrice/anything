<!doctype html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <script src="assets/gsap.min.js"></script>
    <style>
      @font-face { font-family: "Inter"; font-weight: 500; src: url("assets/fonts/inter-latin-500-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 600; src: url("assets/fonts/inter-latin-600-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 700; src: url("assets/fonts/inter-latin-700-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 800; src: url("assets/fonts/inter-latin-800-normal.woff2") format("woff2"); }
      @font-face { font-family: "Inter"; font-weight: 900; src: url("assets/fonts/inter-latin-900-normal.woff2") format("woff2"); }

      :root {
        --bg: #0d0a12;
        --panel: #1a1522;
        --panel-2: #241d2f;
        --line: rgba(255, 255, 255, 0.1);
        --text: #f6f1f8;
        --muted: #a79fb2;
        --rose: #f2a7bd;
        --rose-deep: #e0718f;
        --green: #3ddc97;
        --red: #ff5468;
        --violet: #9b7bff;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: var(--bg); }
      body { font-family: "Inter", sans-serif; color: var(--text); }

      #root { position: relative; width: 100%; height: 100%; overflow: hidden;
        background: radial-gradient(1200px 900px at 50% 20%, #2a1630 0%, var(--bg) 60%); }

      /* ---------- layout ---------- */
      .scene { position: absolute; left: 0; top: 0; width: 1080px; height: 1200px; overflow: hidden; }
      #presenter { position: absolute; left: 0; top: 1200px; width: 1080px; height: 720px;
        background: linear-gradient(180deg, #17111d 0%, #0d0a12 100%);
        border-top: 2px solid rgba(242, 167, 189, 0.25); }
      .cam-tag { position: absolute; left: 40px; top: 32px; font-size: 22px; font-weight: 700; letter-spacing: 3px;
        color: rgba(246, 241, 248, 0.35); text-transform: uppercase; }
      .orb { position: absolute; left: 440px; top: 70px; width: 200px; height: 200px; border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #ffd3df 0%, var(--rose) 35%, var(--rose-deep) 70%, #7d2c4a 100%);
        box-shadow: 0 0 80px rgba(242, 167, 189, 0.45); }
      .orb-ring { position: absolute; left: 400px; top: 30px; width: 280px; height: 280px; border-radius: 50%;
        border: 3px solid rgba(242, 167, 189, 0.35); }
      .cap { position: absolute; left: 60px; top: 340px; width: 960px; height: 300px; display: flex;
        align-items: center; justify-content: center; text-align: center; opacity: 0;
        font-size: 70px; line-height: 1.15; font-weight: 900; letter-spacing: -1px; }
      .cap .w { color: rgba(246, 241, 248, 0.45); margin: 0 10px; }

      /* ---------- kinetic type ---------- */
      .field { position: absolute; inset: 0; }
      .tag { position: absolute; left: 0; top: 70px; width: 1080px; text-align: center; font-size: 30px; font-weight: 800;
        letter-spacing: 8px; color: rgba(255, 255, 255, 0.7); }
      .big-num { position: absolute; right: 40px; bottom: 10px; font-size: 300px; font-weight: 900; letter-spacing: -12px;
        color: #fff; line-height: 1; }
      .big-num .bn { display: block; opacity: 0.07; }
      .ph { position: absolute; left: 60px; top: 150px; width: 960px; height: 980px; display: flex; flex-direction: column;
        align-items: center; justify-content: center; text-align: center; }
      .ln { display: block; overflow: hidden; font-weight: 900; line-height: 1.02; letter-spacing: -4px; padding: 0 8px; }
      .ln .in { display: block; }
      .ch { display: inline-block; }
      .ico { display: block; margin-bottom: 30px; }
      .stamp { position: absolute; left: 140px; width: 800px; height: 190px; border: 12px solid var(--red); border-radius: 26px;
        display: flex; align-items: center; justify-content: center; font-size: 130px; font-weight: 900; color: var(--red);
        letter-spacing: -4px; background: rgba(40, 6, 16, 0.75); }
      .booked { position: absolute; left: 160px; width: 760px; height: 150px; border-radius: 30px; display: flex; align-items: center;
        justify-content: center; font-size: 120px; font-weight: 900; letter-spacing: -4px; color: #1a0a12; background: #fff; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="61.2" data-width="1080" data-height="1920">

      <audio id="vo" src="assets/voiceover.mp3" data-start="0" data-duration="60.92" data-track-index="9" data-volume="1"></audio>

      <!-- ================= PAIN (0 - 11.44) : deep red / plum ================= -->
      <div id="k1" class="scene clip" data-start="0" data-duration="11.44" data-track-index="1">
        <div class="field" style="background: radial-gradient(900px 700px at 50% 40%, #6b1230 0%, #2a0716 70%);"></div>
        <div class="big-num"><span class="bn">!</span></div>
        <div id="k1-tag" class="tag">MED SPA OWNERS</div>

        <div id="k1a" class="ph" data-layout-allow-overlap>
          <svg id="k1a-ico" class="ico" width="150" height="150" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18.5h2"/><path d="M2.5 7.5c-.8 1.5-.8 3.5 0 5"/><path d="M21.5 7.5c.8 1.5.8 3.5 0 5"/></svg>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">YOUR PHONE</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 230px; color: #ffb3c4;"><span class="in">RINGS</span></span>
        </div>

        <div id="k1b" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 108px;"><span class="in">YOU'RE WITH</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 140px; color: #ffb3c4;"><span class="in">A PATIENT</span></span>
        </div>

        <div id="k1c" style="position:absolute; inset: 0;" data-layout-allow-overlap>
          <div id="st1" class="stamp" style="top: 260px;">MISSED.</div>
          <div id="st2" class="stamp" style="top: 500px;">MISSED.</div>
          <div id="st3" class="stamp" style="top: 740px;">MISSED.</div>
        </div>

        <div id="k1d" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 200px;"><span class="in">NO</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">VOICEMAIL.</span></span>
        </div>

        <div id="k1e" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">THEY CALL</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">THE NEXT</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 170px; color: var(--red);"><span class="in">MED SPA</span></span>
        </div>
      </div>

      <!-- ================= SYSTEM 1 (11.44 - 28.2) : violet ================= -->
      <div id="k2" class="scene clip" data-start="11.44" data-duration="16.76" data-track-index="1">
        <div class="field" style="background: radial-gradient(900px 700px at 50% 40%, #4b2aa8 0%, #170b3d 72%);"></div>
        <div class="big-num"><span class="bn">01</span></div>
        <div id="k2-tag" class="tag">SO HERE'S WHAT I BUILD</div>

        <div id="k2a" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 330px; letter-spacing: -12px; color: #d9cbff;"><span class="in">AI</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 108px;"><span class="in">RECEPTIONIST</span></span>
        </div>

        <div id="k2b" class="ph" data-layout-allow-overlap>
          <span id="k2b1" class="ln" data-layout-allow-overflow style="font-size: 150px;"><span class="in">ANSWERS.</span></span>
          <span id="k2b2" class="ln" data-layout-allow-overflow style="font-size: 160px; color: #d9cbff;"><span class="in">PRICES.</span></span>
          <span id="k2b3" class="ln" data-layout-allow-overflow style="font-size: 160px; color: var(--green);"><span class="in">BOOKS.</span></span>
          <svg id="k2b-ico" class="ico" style="margin: 30px 0 0;" width="130" height="130" viewBox="0 0 24 24" fill="none" stroke="#3ddc97" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M3 9.5h18"/><path d="M8 2.5v4"/><path d="M16 2.5v4"/><path id="k2b-check" d="M8.5 15l2.5 2.5 4.5-5"/></svg>
        </div>

        <div id="k2c" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 240px;"><span class="in">HUNG</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 240px; color: #ffb3c4;"><span class="in">UP?</span></span>
        </div>

        <div id="k2d" class="ph" data-layout-allow-overlap>
          <svg class="ico" width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5h16a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H9l-5 4V6a1.5 1.5 0 0 1 1.5-1.5z"/><path d="M8 9.5h8"/><path d="M8 13h5"/></svg>
          <span class="ln" data-layout-allow-overflow style="font-size: 130px;"><span class="in">TEXTED IN</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 130px; color: var(--green);"><span class="in">3 SECONDS</span></span>
        </div>
      </div>

      <!-- ================= SYSTEM 2 (28.2 - 39.35) : blue ================= -->
      <div id="k3" class="scene clip" data-start="28.2" data-duration="11.15" data-track-index="1">
        <div class="field" style="background: radial-gradient(900px 700px at 50% 40%, #1857b8 0%, #061a3f 72%);"></div>
        <div class="big-num"><span class="bn">02</span></div>
        <div id="k3-tag" class="tag">INSTAGRAM DMs</div>

        <div id="k3-clock" style="position:absolute; left: 0; top: 150px; width: 1080px; text-align: center; font-size: 240px; font-weight: 900; letter-spacing: -10px; color: rgba(255,255,255,0.1); line-height: 1;" data-layout-allow-overlap>
          <span id="k3-num">11:04</span><span id="k3-pm" style="font-size: 120px; letter-spacing: -2px;"> PM</span>
        </div>

        <div id="k3a" class="ph" style="top: 420px; height: 700px;" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 130px;"><span class="in">"HOW MUCH</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 118px; color: #9ed0ff;"><span class="in">FOR LIPS?"</span></span>
        </div>

        <div id="k3b" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">ANSWERED.</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px; color: var(--green);"><span class="in">INSTANTLY.</span></span>
        </div>

        <div id="k3c" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 110px; color: rgba(255,255,255,0.75);"><span class="in">NOT</span></span>
          <div style="position: relative;">
            <span class="ln" data-layout-allow-overflow style="font-size: 150px; color: rgba(255,255,255,0.75);"><span class="in">TOMORROW</span></span>
            <div id="k3-strike" style="position:absolute; left: -20px; top: 72px; width: 0; height: 18px; border-radius: 9px; background: var(--red);"></div>
          </div>
        </div>
      </div>

      <!-- ================= SYSTEM 3 (39.35 - 49.5) : rose ================= -->
      <div id="k4" class="scene clip" data-start="39.35" data-duration="10.15" data-track-index="1">
        <div class="field" style="background: radial-gradient(900px 700px at 50% 40%, #b03a68 0%, #3d0b22 72%);"></div>
        <div class="big-num"><span class="bn">03</span></div>
        <div id="k4-tag" class="tag">OLD CLIENTS</div>

        <div id="k4a" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 140px;"><span class="in">CAME IN</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 200px; color: #ffd0de;"><span class="in">ONCE.</span></span>
        </div>

        <div id="k4b" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 170px;"><span class="in">NEVER</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 118px; color: #ffd0de;"><span class="in">CAME BACK.</span></span>
        </div>

        <div id="k4c" class="ph" data-layout-allow-overlap>
          <svg class="ico" width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 3 10 14"/><path d="M21 3l-7 18-4-7-7-4z"/></svg>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">ONE</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 150px; color: #ffd0de;"><span class="in">PERSONAL</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px;"><span class="in">TEXT</span></span>
        </div>

        <div id="k4d" style="position:absolute; inset: 0;" data-layout-allow-overlap>
          <div id="bk1" class="booked" style="top: 210px;">BOOKED.</div>
          <div id="bk2" class="booked" style="top: 420px;">BOOKED.</div>
          <div id="bk3" class="booked" style="top: 630px;">BOOKED.</div>
          <div id="bk4" class="booked" style="top: 840px;">BOOKED.</div>
        </div>
      </div>

      <!-- ================= PAYOFF (49.5 - 55.6) : green ================= -->
      <div id="k5" class="scene clip" data-start="49.5" data-duration="6.1" data-track-index="1">
        <div class="field" style="background: radial-gradient(900px 700px at 50% 40%, #138a5c 0%, #04291b 72%);"></div>
        <div id="k5-tag" class="tag">ALL ON AUTOPILOT</div>

        <div id="k5a" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px; color: rgba(255,255,255,0.7);"><span class="in">NO MORE</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 160px;"><span class="in">MISSED</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 160px;"><span class="in">CALLS.</span></span>
        </div>

        <div id="k5b" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 120px; color: rgba(255,255,255,0.7);"><span class="in">NO MORE</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 160px;"><span class="in">IGNORED</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 160px;"><span class="in">DMs.</span></span>
        </div>

        <div id="k5c" class="ph" data-layout-allow-overlap>
          <span class="ln" data-layout-allow-overflow style="font-size: 250px; letter-spacing: -10px; color: #a8ffd6;"><span class="in">MONEY</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 96px;"><span class="in">FROM CLIENTS</span></span>
          <span class="ln" data-layout-allow-overflow style="font-size: 84px;"><span class="in">YOU ALREADY HAD</span></span>
        </div>
      </div>

      <!-- ================= CTA (55.6 - 61.2) ================= -->
      <div id="k6" class="scene clip" data-start="55.6" data-duration="5.6" data-track-index="1">
        <div class="field" style="background: radial-gradient(900px 700px at 50% 40%, #3a1430 0%, #0d0a12 72%);"></div>
        <div id="k6a" class="ph" style="top: 110px; height: 300px;">
          <span class="ln" data-layout-allow-overflow style="font-size: 84px;"><span class="in">OWN A MED SPA?</span></span>
        </div>
        <div id="k6b" style="position:absolute; left: 0; top: 400px; width: 1080px; text-align: center; font-size: 110px; font-weight: 900; letter-spacing: 6px; color: rgba(255,255,255,0.8);">COMMENT</div>
        <div id="k6c" data-layout-allow-overlap style="position:absolute; left: 0; top: 520px; width: 1080px; text-align: center; font-size: 360px; font-weight: 900; letter-spacing: -14px; line-height: 1; color: var(--rose);">
          <span class="ch">S</span><span class="ch">P</span><span class="ch">A</span>
        </div>
        <div id="k6-arrow" style="position:absolute; left: 480px; top: 930px; width: 120px; height: 200px;">
          <svg width="120" height="200" viewBox="0 0 120 200" fill="none" stroke="#f2a7bd" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"><path d="M60 12v170"/><path d="M16 138l44 44 44-44"/></svg>
        </div>
      </div>

      <!-- ================= presenter zone (camera goes here later) ================= -->
      <div id="presenter" class="clip" data-start="0" data-duration="61.2" data-track-index="0">
        <div class="cam-tag">Your camera here</div>
        <div id="orb-ring" class="orb-ring"></div>
        <div id="orb" class="orb"></div>
        <div id="caps"></div>
      </div>
    </div>

    <script>
      const WORDS = __WORDS__;
      const tl = gsap.timeline({ paused: true });
      const E = "power3.out";

      // ---------- captions (bottom zone) ----------
      const caps = document.getElementById("caps");
      const groups = [];
      let cur = [];
      WORDS.forEach((w, i) => {
        cur.push(w);
        const endsSentence = /[.,?!"]$/.test(w[0]);
        const next = WORDS[i + 1];
        const gap = next ? next[1] - w[2] : 1;
        if (cur.length >= 4 || endsSentence || gap > 0.3 || !next) { groups.push(cur); cur = []; }
      });
      groups.forEach((g, gi) => {
        const el = document.createElement("div");
        el.className = "cap";
        el.id = "cap" + gi;
        el.innerHTML = g.map((w, wi) => `<span class="w" id="cap${gi}w${wi}">${w[0].replace(/"/g, "")}</span>`).join(" ");
        caps.appendChild(el);
        const start = g[0][1];
        const nextG = groups[gi + 1];
        const end = nextG ? nextG[0][1] : g[g.length - 1][2] + 0.3;
        tl.fromTo(el, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.15, ease: E }, start);
        tl.set(el, { opacity: 0 }, end);
        g.forEach((w, wi) => {
          tl.set(`#cap${gi}w${wi}`, { color: /SPA|AI|Google|Instagram|instantly|calendar|lips|seconds|money|book/i.test(w[0]) ? "#f2a7bd" : "#ffffff" }, w[1]);
        });
      });

      // orb "speaking" pulse, keyed to word starts
      WORDS.forEach((w) => {
        tl.fromTo("#orb", { scale: 1.08 }, { scale: 1, duration: Math.max(0.12, w[2] - w[1]), ease: "power2.out" }, w[1]);
      });
      tl.fromTo("#orb-ring", { scale: 0.9, opacity: 0.6 }, { scale: 1.15, opacity: 0, duration: 1.6, ease: "sine.out", repeat: 37 }, 0);

      // ---------- kinetic helpers ----------
      const lines = (ph) => Array.from(document.querySelector(ph).querySelectorAll(".ln .in"));
      // mask reveal: each line rises out of its own clip box
      const reveal = (ph, times) => lines(ph).forEach((el, i) => {
        tl.fromTo(el, { yPercent: 110 }, { yPercent: 0, duration: 0.45, ease: "power4.out" }, times[Math.min(i, times.length - 1)]);
      });
      // slam: scale down from big with overshoot
      const slam = (sel, t, from = 1.8) => tl.fromTo(sel, { scale: from, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.38, ease: "back.out(1.8)" }, t);
      // push previous phrase up and off
      const pushOut = (ph, t) => tl.to(ph, { y: -260, opacity: 0, duration: 0.32, ease: "power3.in" }, t);
      const tagIn = (sel, t) => tl.fromTo(sel, { opacity: 0, y: -24 }, { opacity: 1, y: 0, duration: 0.5, ease: E }, t);

      // ---------- PAIN (0 - 11.44) ----------
      tagIn("#k1-tag", 0.0);
      tl.fromTo("#k1a-ico", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.4, ease: "back.out(2)" }, 1.6);
      tl.fromTo("#k1a-ico", { rotation: -10 }, { rotation: 10, duration: 0.06, repeat: 19, yoyo: true, ease: "none" }, 2.32);
      reveal("#k1a", [2.16, 2.64]);
      pushOut("#k1a", 3.05);
      reveal("#k1b", [3.12, 3.44]);
      tl.to("#k1b", { opacity: 0, scale: 0.9, duration: 0.25, ease: "power2.in" }, 4.3);
      tl.to("#k1-tag", { opacity: 0, duration: 0.25 }, 4.3);
      [["#st1", 4.4, -6], ["#st2", 5.04, 4], ["#st3", 5.8, -3]].forEach(([s, t, r]) => {
        tl.fromTo(s, { scale: 2.4, opacity: 0, rotation: r * 3 }, { scale: 1, opacity: 1, rotation: r, duration: 0.28, ease: "power4.in" }, t);
        tl.fromTo("#k1", { x: 0 }, { x: 14, duration: 0.05, repeat: 3, yoyo: true, ease: "none" }, t + 0.28);
      });
      tl.to("#k1c", { opacity: 0, duration: 0.3 }, 7.3);
      reveal("#k1d", [7.52, 7.84]);
      pushOut("#k1d", 8.55);
      reveal("#k1e", [8.64, 9.28, 9.68]);

      // ---------- SYSTEM 1 (11.44 - 28.2) ----------
      tagIn("#k2-tag", 11.5);
      tl.fromTo("#k2 .big-num", { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.8, ease: E }, 11.5);
      slam("#k2a .ln:nth-child(1)", 14.64, 2.2);
      reveal("#k2a", [14.64, 14.96]);
      pushOut("#k2a", 16.95);
      slam("#k2b1", 17.2);
      slam("#k2b2", 19.36);
      slam("#k2b3", 20.4);
      tl.fromTo("#k2b-ico", { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.4, ease: E }, 21.6);
            tl.to("#k2b", { scale: 0.85, opacity: 0, duration: 0.3, ease: "power2.in" }, 22.6);
      tl.to("#k2-tag", { opacity: 0, duration: 0.25 }, 22.6);
      slam("#k2c .ln:nth-child(1)", 23.04, 2.4);
      slam("#k2c .ln:nth-child(2)", 23.28, 2.4);
      tl.fromTo("#k2c", { rotation: 0 }, { rotation: -3, duration: 0.4, ease: "power2.out" }, 23.6);
      pushOut("#k2c", 24.85);
      tl.fromTo("#k2d .ico", { opacity: 0, scale: 0.5 }, { opacity: 1, scale: 1, duration: 0.35, ease: "back.out(2.5)" }, 24.9);
      reveal("#k2d", [25.04, 25.84]);

      // ---------- SYSTEM 2 (28.2 - 39.35) ----------
      tagIn("#k3-tag", 28.3);
      tl.fromTo("#k3 .big-num", { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.8, ease: E }, 28.3);
      tl.fromTo("#k3-clock", { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.6, ease: E }, 29.9);
      reveal("#k3a", [30.96, 31.44]);
      tl.to("#k3a", { y: 120, opacity: 0, duration: 0.3, ease: "power3.in" }, 32.05);
      tl.to("#k3-clock", { color: "rgba(255,255,255,1)", y: 300, duration: 0.5, ease: "power3.out" }, 32.24);
      tl.to("#k3-clock", { y: -500, opacity: 0, duration: 0.35, ease: "power3.in" }, 33.4);
      tl.to("#k3-tag", { opacity: 0, duration: 0.25 }, 33.4);
      reveal("#k3b", [34.08, 35.6]);
      tl.fromTo("#k3b .ln:nth-child(2) .in", { scale: 1 }, { scale: 1.06, duration: 0.18, yoyo: true, repeat: 1 }, 36.0);
      pushOut("#k3b", 36.5);
      reveal("#k3c", [36.64, 36.88]);
      tl.to("#k3-strike", { width: "108%", duration: 0.45, ease: "power2.inOut" }, 37.5);
      tl.to("#k3c .ln", { opacity: 0.45, duration: 0.3 }, 37.9);

      // ---------- SYSTEM 3 (39.35 - 49.5) ----------
      tagIn("#k4-tag", 39.45);
      tl.fromTo("#k4 .big-num", { opacity: 0, x: 80 }, { opacity: 1, x: 0, duration: 0.8, ease: E }, 39.45);
      reveal("#k4a", [41.12, 41.52]);
      pushOut("#k4a", 42.05);
      reveal("#k4b", [42.16, 42.48]);
      pushOut("#k4b", 43.5);
      tl.fromTo("#k4c .ico", { opacity: 0, x: -300, y: 120 }, { opacity: 1, x: 0, y: 0, duration: 0.5, ease: E }, 43.6);
      reveal("#k4c", [44.0, 44.24, 44.8]);
      tl.to("#k4c .ico", { x: 400, y: -300, opacity: 0, duration: 0.45, ease: "power3.in" }, 46.3);
      tl.to("#k4c", { opacity: 0, scale: 0.9, duration: 0.3, ease: "power2.in" }, 46.8);
      tl.to("#k4-tag", { opacity: 0, duration: 0.25 }, 46.8);
      [["#bk1", 47.2], ["#bk2", 47.6], ["#bk3", 48.0], ["#bk4", 48.64]].forEach(([s, t], i) => {
        tl.fromTo(s, { scale: 1.6, opacity: 0, rotation: i % 2 ? 4 : -4 }, { scale: 1, opacity: 1, rotation: i % 2 ? 1.5 : -1.5, duration: 0.32, ease: "back.out(2.2)" }, t);
      });

      // ---------- PAYOFF (49.5 - 55.6) ----------
      tagIn("#k5-tag", 49.55);
      reveal("#k5a", [49.52, 49.92, 50.16]);
      pushOut("#k5a", 50.95);
      reveal("#k5b", [51.04, 51.56, 51.84]);
      pushOut("#k5b", 52.7);
      slam("#k5c .ln:nth-child(1)", 53.12, 2.0);
      reveal("#k5c", [53.12, 53.44, 54.16]);

      // ---------- CTA (55.6 - 61.2) ----------
      reveal("#k6a", [55.76]);
      tl.fromTo("#k6b", { opacity: 0, scale: 1.3 }, { opacity: 1, scale: 1, duration: 0.45, ease: E }, 57.2);
      document.querySelectorAll("#k6c .ch").forEach((c, i) => {
        tl.fromTo(c, { yPercent: -120, opacity: 0, rotation: (i - 1) * 12 }, { yPercent: 0, opacity: 1, rotation: 0, duration: 0.45, ease: "bounce.out" }, 57.68 + i * 0.1);
      });
      tl.fromTo("#k6-arrow", { opacity: 0, y: -20 }, { opacity: 1, y: 20, duration: 0.45, repeat: 7, yoyo: true, ease: "sine.inOut" }, 58.5);

      window.__timelines["main"] = tl;
    </script>
  </body>
</html>
