SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=changeme

FROM_EMAIL=you@yourdomain.com
FROM_NAME=Your Name
SENDER_TITLE=Founder, Your Company
REPLY_TO_EMAIL=you@yourdomain.com
REPLY_PHONE=555-555-5555

# Required by CAN-SPAM in every commercial email
MAILING_ADDRESS=123 Main St, Suite 100, Yourtown, ST 00000
UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe?email={{email}}
