# Copy this file to .env and fill in your RapidAPI keys.
# Each key can be from a different RapidAPI account to maximize free tier limits.

# Account 1 key — used for Google Keyword Insight API
RAPIDAPI_KEY_1=your_first_rapidapi_key_here

# Account 2 key — used for Twinword Keyword Suggestion API
RAPIDAPI_KEY_2=your_second_rapidapi_key_here
